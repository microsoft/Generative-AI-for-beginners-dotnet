<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AI.Foundry.Local" Version="2.3.1" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
    <PackageReference Include="OpenAI" Version="2.14.0" />
    <Compile Include="$(MSBuildThisFileDirectory)FoundryCourseRuntime.cs" Link="FoundryCourseRuntime.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)FoundryCourseChecks.cs" Link="FoundryCourseChecks.cs" />
  </ItemGroup>
</Project>
